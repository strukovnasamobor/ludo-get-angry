rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@gmail[.]com');
    }

    match /rooms/{roomId} {

      function existing()    { return resource.data; }
      function incoming()    { return request.resource.data; }
      function uid()         { return request.auth.uid; }
      function isHost()      { return existing().hostUid == uid(); }
      function isMember()    { return uid() in existing().playerUids; }

      // The host's heartbeat (presence) is older than 60s, or the host is no
      // longer in the room. Used to widen recovery authority so the game doesn't
      // stall when the host (who is usually also seat 0) disconnects.
      function hostStale() {
        return !(existing().hostUid in existing().playerUids)
          || ( 'presence' in existing()
            && existing().hostUid in existing().presence
            && existing().presence[existing().hostUid].toMillis() < request.time.toMillis() - 60000 );
      }

      // A "recoverer" may drive cross-player recovery writes (stale-skip, kick).
      // The host is primary; seat 0 (players[0]) is the fallback. If the host has
      // disconnected (hostStale), ANY member may recover — otherwise, when host
      // == seat 0, an absent host would freeze the room (nobody could even remove
      // the stale host). Recovery writes stay tightly constrained (size-preserving,
      // never minting a dice, or roster shrink), so widening the *writer* set
      // can't grant new powers. `d` is the existing room doc — pass existing() at
      // non-parameterized call sites.
      function recovererP(d) {
        return d.hostUid == uid()
          || (d.players.size() > 0 && d.players[0].uid == uid())
          || hostStale();
      }

      function createShapeOk() {
        return incoming().keys().hasOnly(
          ['code', 'hostUid', 'status', 'players', 'playerUids',
           'gameState', 'createdAt', 'updatedAt']
        )
          && incoming().code is string
          && incoming().code.matches('^[A-Z0-9]{6}$')
          && incoming().hostUid == uid()
          && incoming().status == 'waiting'
          && incoming().players is list
          && incoming().players.size() == 1
          && incoming().players[0].uid == uid()
          && incoming().playerUids is list
          && incoming().playerUids.size() == 1
          && incoming().playerUids[0] == uid()
          && incoming().gameState == null;
      }

      function sizeOk() {
        return incoming().players is list
          && incoming().playerUids is list
          && incoming().players.size() <= 8
          && incoming().playerUids.size() == incoming().players.size();
      }

      function immutableFieldsUnchanged() {
        return incoming().code == existing().code
          && incoming().createdAt == existing().createdAt;
      }

      // ---- update transitions ----

      // Join while waiting: adds own entry, no other player/game changes.
      function isJoin() {
        return existing().status == 'waiting'
          && incoming().status == 'waiting'
          && incoming().hostUid == existing().hostUid
          && incoming().gameState == existing().gameState
          && !isMember()
          && (uid() in incoming().playerUids)
          && incoming().playerUids.size() == existing().playerUids.size() + 1
          && incoming().players.size() == existing().players.size() + 1;
      }

      // Leave or stale-removal WHILE gameState is unchanged (waiting room, or a
      // removal that does not touch the board). Active-game removals that also
      // shrink gameState go through isRemovalCascade() instead.
      function isLeaveOrRemoval() {
        return incoming().players.size() < existing().players.size()
          && incoming().playerUids.size() < existing().playerUids.size()
          && incoming().gameState == existing().gameState
          && incoming().status == existing().status
          && (
            (incoming().hostUid == existing().hostUid
              && incoming().hostUid in incoming().playerUids)
            || (incoming().players.size() > 0
              && incoming().hostUid == incoming().players[0].uid)
            || incoming().players.size() == 0
          );
      }

      // Self-edit of own name/color. uids pinned via playerUids so no impersonation.
      function isSelfEdit() {
        return incoming().status == existing().status
          && incoming().hostUid == existing().hostUid
          && incoming().gameState == existing().gameState
          && incoming().players.size() == existing().players.size()
          && incoming().playerUids == existing().playerUids
          && isMember();
      }

      // Host transitions waiting → active (gameState still null; it is seeded
      // separately by isSeedGameState once the board mounts).
      function isStartGame() {
        return isHost()
          && existing().status == 'waiting'
          && incoming().status == 'active'
          && incoming().hostUid == existing().hostUid
          && incoming().players == existing().players
          && incoming().playerUids == existing().playerUids;
      }

      // Presence heartbeat — touches the `presence` map only.
      function isPresenceWrite() {
        return incoming().status == existing().status
          && incoming().hostUid == existing().hostUid
          && incoming().players == existing().players
          && incoming().playerUids == existing().playerUids
          && incoming().gameState == existing().gameState
          && isMember();
      }

      // ---- gameState helpers ----

      function gsExisting() { return existing().gameState; }
      function gsIncoming() { return incoming().gameState; }

      // Seed the first gameState (null → initial-roll) once the game is active.
      // Host only, so racing clients don't write divergent randomized seeds.
      function isSeedGameState() {
        return isHost()
          && existing().status == 'active' && incoming().status == 'active'
          && incoming().hostUid == existing().hostUid
          && incoming().players == existing().players
          && incoming().playerUids == existing().playerUids
          && gsExisting() == null
          && gsIncoming() != null
          && gsIncoming().phase == 'initial-roll'
          && gsIncoming().players.size() == incoming().players.size();
      }

      // Recoverer kick during an active game: shrink room roster AND gameState
      // in a SINGLE write so the two stay consistent (isLeaveOrRemoval forbids
      // gameState changes, so it cannot cover this case).
      function isRemovalCascade() {
        return recovererP(existing())
          && incoming().players.size() < existing().players.size()
          && incoming().playerUids.size() < existing().playerUids.size()
          && incoming().status == existing().status
          && gsExisting() != null && gsIncoming() != null
          && gsIncoming().players.size() <= gsExisting().players.size()
          && gsIncoming().players.size() == incoming().players.size()
          && ( incoming().hostUid in incoming().playerUids
            || incoming().players.size() == 0
            || incoming().hostUid == incoming().players[0].uid );
      }

      // ---- parameterized active-game write rules ----
      // d/n = existing/incoming room doc; g/h = existing/incoming gameState.
      // Threading these as parameters (instead of re-deriving existing().game-
      // State on every helper call) keeps a single write well under Firestore's
      // 1000-expression evaluation limit.

      function curIdxOkP(g) {
        return g.players is list && g.currentPlayerIndex is int
          && g.currentPlayerIndex >= 0
          && g.currentPlayerIndex < g.players.size();
      }
      function currentIsMeP(g) {
        return curIdxOkP(g) && g.players[g.currentPlayerIndex].uid == uid();
      }

      // Structural invariants every active-game gameState write must satisfy.
      function structOkP(d, n, g, h) {
        return h.phase == 'game-over'
          ? ( h.players.size() <= g.players.size()
              && n.players == d.players && n.playerUids == d.playerUids )
          : ( curIdxOkP(g)
            && h.currentPlayerIndex is int
            && h.currentPlayerIndex >= 0
            && h.currentPlayerIndex < h.players.size()
            && h.players.size() <= g.players.size()
            && h.players.size() == n.players.size()
            && h.standings.size() >= g.standings.size()
            && n.players == d.players
            && n.playerUids == d.playerUids );
      }

      // Normal move by the current player (select/place/end-turn/duel & special
      // resolution). A move may NOT mint a new diceValue — only keep or clear it;
      // new dice values come only from a verified roll. Never carries a seed.
      function moveP(g, h) {
        return currentIsMeP(g)
          && h.phase != 'initial-roll'
          && (h.diceValue == g.diceValue || h.diceValue == null)
          && h.get('rollSeed', null) == null;
      }

      // Milliseconds of the committed seed (only call when rollSeed is present).
      function seedMs(g) { return g.get('rollSeed', null).toMillis(); }

      // Who may commit a roll seed now. rolling/six-action/moving: the current
      // player. duel: the attacker before atkRoll, then the defender (defUid)
      // between atkRoll and defRoll — serialized via the single seed slot.
      // initial-roll: any member (roller is a color, unresolvable here; the value
      // is still server-fixed and verified on derive).
      function rollActorP(g) {
        return g.phase == 'duel'
          ? ( g.duelState != null && (
                (currentIsMeP(g) && g.duelState.atkRoll == null)
                || (g.duelState.defUid == uid()
                    && g.duelState.atkRoll != null && g.duelState.defRoll == null) ) )
          : ( g.phase == 'initial-roll' || currentIsMeP(g) );
      }

      // Verifiable roll, phase 1: commit a server-stamped seed. Must equal
      // request.time (client can't choose it); no roll in flight; only the seed
      // changes.
      function rollInitP(g, h) {
        return rollActorP(g)
          && g.get('rollSeed', null) == null
          && h.get('rollSeed', null) == request.time
          && h.diceValue == g.diceValue
          && h.currentPlayerIndex == g.currentPlayerIndex
          && h.phase == g.phase
          && h.standings == g.standings
          && h.players == g.players;
      }

      // Phase 2 — derive branches. Each: seed present in g, cleared in h, and the
      // written value(s) equal the rule's own recomputation, so they can't be
      // forged and the seed lock prevents re-rolling.

      // Main turn roll → diceValue.
      function rollDeriveP(g, h) {
        return currentIsMeP(g) && g.phase == 'rolling'
          && g.get('rollSeed', null) != null
          && h.get('rollSeed', null) == null
          && h.diceValue == (seedMs(g) % 6) + 1;
      }

      // KOCKA ('dice' special) → specialTrigger.d1 / d2 (two dice from one seed).
      function kockaDeriveP(g, h) {
        return currentIsMeP(g)
          && g.phase == 'special-trigger' && g.specialTrigger != null
          && g.specialTrigger.type == 'dice'
          && g.get('rollSeed', null) != null
          && h.get('rollSeed', null) == null
          && h.specialTrigger.d1 == (seedMs(g) % 6) + 1
          && h.specialTrigger.d2 == ((seedMs(g) / 6) % 6) + 1
          && h.players == g.players
          && h.currentPlayerIndex == g.currentPlayerIndex
          && h.standings == g.standings;
      }

      // Duel attacker roll → duelState.atkRoll (current player, before defender).
      function duelAtkDeriveP(g, h) {
        return currentIsMeP(g)
          && g.phase == 'duel' && g.duelState != null && g.duelState.atkRoll == null
          && g.get('rollSeed', null) != null
          && h.get('rollSeed', null) == null
          && h.duelState.atkRoll == (seedMs(g) % 6) + 1
          && h.duelState.defRoll == g.duelState.defRoll
          && h.players == g.players
          && h.currentPlayerIndex == g.currentPlayerIndex
          && h.phase == 'duel' && h.standings == g.standings;
      }

      // Duel defender roll → duelState.defRoll (defUid, after the attacker).
      function duelDefDeriveP(g, h) {
        return g.phase == 'duel' && g.duelState != null
          && g.duelState.defUid == uid()
          && g.duelState.atkRoll != null && g.duelState.defRoll == null
          && g.get('rollSeed', null) != null
          && h.get('rollSeed', null) == null
          && h.duelState.defRoll == (seedMs(g) % 6) + 1
          && h.duelState.atkRoll == g.duelState.atkRoll
          && h.players == g.players
          && h.currentPlayerIndex == g.currentPlayerIndex
          && h.phase == 'duel' && h.standings == g.standings;
      }

      // Initial-roll value → initialRolls[roller]. Any member; value verified.
      // (Winner/tie selection isn't enforceable in rules — documented residual.)
      function initialDeriveP(g, h) {
        return g.phase == 'initial-roll'
          && g.initialRollOrder is list
          && g.initialRollIdx is int && g.initialRollIdx >= 0
          && g.initialRollIdx < g.initialRollOrder.size()
          && g.get('rollSeed', null) != null
          && h.get('rollSeed', null) == null
          && h.initialRolls.get(g.initialRollOrder[g.initialRollIdx], -1) == (seedMs(g) % 6) + 1
          && h.players.size() == g.players.size();
      }

      // Recoverer handling an ABSENT active player: a bare skip, or one random
      // move played with the absent player's ALREADY-rolled (verified) dice.
      // The recoverer never rolls, so it can't choose a dice. Roster size is
      // pinned; standings may only grow (a recovery move can finish a piece).
      // CRITICAL: the recoverer must NOT be the current player — recovery is for
      // an absent OTHER player. Otherwise a recoverer (host/seat 0) could use
      // this broad transition to forge their own roll on their own turn; on their
      // own turn they must use the normal roll/move flow (rollInitP/rollDeriveP/moveP).
      function staleSkipP(d, g, h) {
        return recovererP(d)
          && !currentIsMeP(g)
          && g.phase != 'initial-roll' && g.phase != 'game-over'
          && h.players.size() == g.players.size()
          && h.standings.size() >= g.standings.size()
          // A recovery write may NOT mint a dice value — it can only keep the
          // absent player's already-rolled (verified) value or clear it. New
          // dice come only from a seed-verified roll, so a recoverer can never
          // choose the dice for anyone.
          && (h.diceValue == g.diceValue || h.diceValue == null);
      }

      // Pre-game initial-roll BOOKKEEPING only (the roll itself goes via
      // rollInitP + initialDeriveP): host flips to 'rolling' (START_GAME) or
      // resets for a tie re-roll (initialRolls must not grow).
      function initialRollP(d, g, h) {
        return g.phase == 'initial-roll' && d.hostUid == uid()
          && h.players.size() == g.players.size()
          && ( h.phase == 'rolling'
            || (h.phase == 'initial-roll'
                && h.initialRolls.size() <= g.initialRolls.size()) );
      }

      // Recoverer (not the current player) drives the board into game-over (e.g.
      // a recovery skip when all others have finished). The current player ends
      // the game through a normal finishing move (moveP), not this path.
      function gameOverP(d, g, h) {
        return recovererP(d) && !currentIsMeP(g) && h.phase == 'game-over'
          && h.players.size() <= g.players.size();
      }

      function isGameStateWriteP(d, n, g, h) {
        return d.status == 'active' && n.status == 'active'
          && n.hostUid == d.hostUid
          && g != null && h != null
          && (uid() in d.playerUids)
          && structOkP(d, n, g, h)
          // Branch on whether a roll seed is in flight so a write only evaluates
          // the relevant half (keeps each write under the 1000-expression limit).
          && ( ( g.get('rollSeed', null) == null
                 ? ( moveP(g, h) || rollInitP(g, h) )
                 : ( rollDeriveP(g, h)
                     || kockaDeriveP(g, h)
                     || duelAtkDeriveP(g, h)
                     || duelDefDeriveP(g, h)
                     || initialDeriveP(g, h) ) )
            || staleSkipP(d, g, h)
            || initialRollP(d, g, h)
            || gameOverP(d, g, h) );
      }

      allow read:   if isAllowedUser();
      allow create: if isAllowedUser() && createShapeOk();
      // Branch on status so active-game writes never evaluate the lobby
      // transitions (and vice-versa), and order each branch with its hot path
      // first. This keeps any single write well under Firestore's 1000-
      // expression evaluation limit — a flat OR over every transition can
      // exceed it once gameState carries real figures/specials.
      allow update: if isAllowedUser()
        && sizeOk()
        && immutableFieldsUnchanged()
        && (
          existing().status == 'active'
            ? ( isGameStateWriteP(existing(), incoming(), gsExisting(), gsIncoming())
                || isSeedGameState()
                || isRemovalCascade()
                || isPresenceWrite()
                || isSelfEdit()
                || isLeaveOrRemoval() )
            : ( isJoin()
                || isStartGame()
                || isSelfEdit()
                || isPresenceWrite()
                || isLeaveOrRemoval() )
        );
      allow delete: if false;
    }
  }
}
